# Fallback for cPanel when the domain's document root cannot point to /public.
# Sends every request into the public/ folder so the project root stays hidden.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
